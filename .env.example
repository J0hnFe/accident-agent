# Copiar a .env y completar. Nunca versionar .env.

# Neo4j. En docker compose el host es "neo4j"; desde el equipo local, "localhost".
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# OpenRouter: clave gratuita en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelos en orden de preferencia; el resto son respaldo ante 429 o fallos.
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free

# Langfuse Cloud (opcional). Sin las dos claves se usa NoopTracer y no hay conexion.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Limites del orquestador (segundos donde aplica)
ORCH_MAX_ITERATIONS=5
ORCH_MAX_TOOL_CALLS_PER_ITERATION=4
LLM_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_TIME_SECONDS=2
TOOL_TIMEOUT_SEARCH_SECONDS=10
TOOL_TIMEOUT_REPORT_SECONDS=15
MEMORY_MAX_TURNS=10

# General
DEFAULT_TIMEZONE=America/Guayaquil
LOG_LEVEL=INFO

# Rutas
DATA_FILE=data/siniestros_raw.json
REPORTS_DIR=reports
LOGS_DIR=logs
